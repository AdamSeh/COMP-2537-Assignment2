<%- include('templates/header') %>

<h1 class="mb-4">Admin Control Center</h1>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% users.forEach(user => 
        { %>
            <tr>
                <td>
                    <%= user.name %>
                </td>
                <td>
                    <span class="badge <%= user.user_type === 'admin' ? 'bg-danger' : 'bg-primary' %>">
                        <%= user.user_type %>
                    </span> 
                </td>
                <td>
                    <% if (user.user_type ==='user')
                       { %>
                            <form action="/promote" method="POST" style="display:inline;">
                                <input type="hidden" name="name" value="<%=user.name%>">
                                <button type="submit" class="btn btn-sm btn-success">promote this user</button>
                            </form>
                    <% }
                       else
                       { %>
                            <form action="/demote" method="POST" style="display:inline;">
                                <input type="hidden" name="name" value="<%=user.name%>">
                                <button type="submit" class="btn btn-sm btn-warning">demote this user</button>
                            </form>
                    <% } %>
                </td>
            </tr>
     <% }) %>
    </tbody>
</table>

<div class="mt-3">
    <a href="/" class="btn btn-secondary">Back to Home</a>
</div>

<%- include('templates/footer') %>